# scripts/ altındaki Node script'lerinin ayarları. Bu dosyayı scripts/.env
# olarak kopyalayıp doldurun. scripts/.env git'e EKLENMEZ.
# Service role anahtarını KÖK .env'e koymayın: kök .env uygulamaya asset
# olarak gömülür ve APK/IPA'yı açan herkes okuyabilir.
SUPABASE_URL=https://<proje>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
# Bülten altbilgisindeki gönderen kimliği (KVKK-11, KVKK-15). Gizlilik
# Politikası §1'deki veri sorumlusu bilgisiyle ve mağazadaki geliştirici
# adıyla aynı olmalı. Boşsa send_newsletter.js gerçek gönderim yapmaz.
# Edge Function için aynı değerler: supabase secrets set MAIL_SENDER_NAME=... MAIL_SENDER_ADDRESS=...
MAIL_SENDER_NAME=
MAIL_SENDER_ADDRESS=
