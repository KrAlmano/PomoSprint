<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ yedekleme kuralları: oturum token'ları ve kullanıcıya özel
     yerel veriler ne bulut yedeğine ne de cihazdan cihaza aktarıma girer.
     Android 11 ve altı için manifest'teki allowBackup="false" geçerlidir. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
