# Cloudflare Workers static assets yanıt başlıkları.
# Bu dosya varlık olarak yayınlanmaz; Workers tarafından okunur.
# Birden fazla kural eşleşirse başlıklar birleşir; "! Ad" önceki kuralın başlığını kaldırır.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; font-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://eoosnyakvxmifmexpgxa.supabase.co https://cloudflareinsights.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cross-Origin-Opener-Policy: same-origin

# Token taşıyan sayfalar: dizine girmez, önbelleğe alınmaz, referrer gönderilmez
/reset-password
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/confirmed
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

/unsubscribe
  ! Referrer-Policy
  Referrer-Policy: no-referrer
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store

# Statik varlıklar. CSS/JS adlarında sürüm yok (yalnızca ?v= sorgusu), bu yüzden kısa ömür.
/css/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/js/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/avatars/*
  Cache-Control: public, max-age=86400

# Ekran adları sürümsüz; yeni uygulama görüntüleri kısa sürede yenilensin.
/screenshots/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/videos/*
  Cache-Control: public, max-age=86400

# Kendi alan adımızdan sunulan yazı tipleri ve GSAP (KVKK-19). Dosya adları
# sürüm taşır (nunito-v32-*.woff2, gsap-3.13.0/); değişirse ad da değişir.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/og-image.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/favicon.ico
  Cache-Control: public, max-age=86400

/apple-touch-icon.png
  Cache-Control: public, max-age=86400
